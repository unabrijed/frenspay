# PRODUCTION variables — the paste-into-Railway reference for the `production` environment.
# NEVER a committed .env: every value here is set in Railway's Variables tab (production env only).
#
# Convention: NODE_ENV selects the prefix. production → BARE names, no STAGE_/LOCAL_ prefix
# (src/envConfig.ts). Same start command as stage; only the variables differ.
# Before wiring any of this, walk DEPLOY.md → "Mainnet checklist" (faucet gating, fee-payer
# funding, security review). Real money starts here. This file is BACKEND vars only — the
# frontend prod vars (incl. web's ACCESS_KEY deploy gate) live per Vercel project; see DEPLOY.md
# and apps/web/.env.example.
NODE_ENV=production

# PORT is injected unprefixed by Railway — do not set it.

# --- Database (REQUIRED — boot is useless without it) ---
# Prod Postgres. On Supabase: the SESSION pooler URL (…pooler.supabase.com:5432). NEVER the
# transaction pooler (port 6543) — the backend + migration runner take session-scoped
# pg_advisory_locks, which transaction pooling silently breaks.
# DATABASE_URL=postgresql://user:pass@host:5432/postgres
# PGSSL=disable        # only for non-SSL Postgres; leave unset on Supabase/Railway

# CORS allowlist — MUST be set in prod, and it must be the FULL comma-separated list of every
# browser origin: web + admin + both landing hosts (the waitlist form POSTs cross-origin).
# Forgetting one silently breaks that surface in prod only. See DEPLOY.stage.md § CORS.
# CORS_ORIGIN=https://admin.frenspay.xyz,https://frenspay.xyz,https://www.frenspay.xyz,https://<web-domain>

# --- Solana (mainnet when live) ---
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<KEY>
# HELIUS_API_KEY=
# Fee-payer keypair, JSON byte array. Funded with REAL SOL — it sponsors every transfer + ATA rent;
# monitor its balance. Generate fresh for prod, never reuse the devnet key.
# FEE_PAYER_SECRET_KEY=
# Circle's mainnet USDC mint (NOT the devnet mint). Setting this exact mint flips config.isMainnet,
# which hard-gates the faucet, /sim/orders, order creation (until the escrow program deploys to
# mainnet), and cross-chain on non-prod tiers — money-realness follows the mint, not NODE_ENV:
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# The platform's cut on merchant-pay orders, in bps ON TOP of the LP spread — folded into the quoted
# rate (never a user-visible line item), collected at deposit into the fee-payer's ATA. Default 50.
# PLATFORM_FEE_BPS=50
# ESCROW_PROGRAM_ID=
# Merchant/LP stake vault. PUBLIC ADDRESS ONLY, never the fee-payer. Unset → staking 503s.
# STAKE_TREASURY_ADDRESS=
# Shared secret for the Helius webhook URL (?secret=...). Set it — open webhooks are a dev nicety.
# HELIUS_WEBHOOK_SECRET=
# Public URL of THIS backend (host-level, unprefixed in every tier). Enables webhook auto-registration.
# PUBLIC_BASE_URL=https://<backend-prod-domain>

# --- Privy ---
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=          # backend-only, never in a web build
# Optional: verification key from the dashboard, skips a network fetch per verify.
# PRIVY_VERIFICATION_KEY=

# --- KYC (REQUIRED at boot — assertKycConfig refuses to start without ALL THREE) ---
# Provider defaults to 'didit' in prod; do not set KYC_PROVIDER=sim here — prod must never
# self-promote tiers. Unlike stage, the webhook secret is also mandatory in production.
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=
# DIDIT_BASE_URL=https://verification.didit.me   # only to override the default

# --- F list: referral loop + confirm email (all four or nothing; unset = safely disabled) ---
# RESEND_API_KEY=
# EMAIL_FROM=fpay <frens@frenspay.xyz>
# WAITLIST_SECRET=           # openssl rand -hex 32 — write-once, rotating kills outstanding links
# LANDING_URL=https://frenspay.xyz

# --- Live FX (sane defaults; set only to override) ---
# FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
# FX_FALLBACK_RATE=87.55         # INR, validated [50,150]
# FX_FALLBACK_RATE_IDR=16500     # IDR, validated [12000,25000]
# FX_REFRESH_MS=21600000

# --- Xendit payouts (unset = payout providers disabled — the safe default) ---
# LIVE keys are a licensing/counsel decision (docs/11), not an env change. Test keys don't belong
# in prod.
# XENDIT_API_URL=https://api.xendit.co
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=

# --- Cross-chain USDC / CCTP (optional; unset = EVM rails off) ---
# IRIS_API_URL defaults to Circle's PRODUCTION API when NODE_ENV=production — no override needed.
# ETHEREUM_RPC_URL=
# BASE_RPC_URL=
# ARBITRUM_RPC_URL=
# EVM_MINTER_PRIVATE_KEY=        # generate fresh for prod, fund with real gas on each chain
# Our per-destination fee in USD on top of protocol costs (defaults: eth 2, base 0, arb 0):
# CCTP_FEE_USD_ETHEREUM=2
# CCTP_FEE_USD_BASE=0
# CCTP_FEE_USD_ARBITRUM=0
# CCTP_IN_FEE_USD_ETHEREUM=2
# CCTP_IN_FEE_USD_BASE=0
# CCTP_IN_FEE_USD_ARBITRUM=0
# Which rail serves each direction (defaults shown; see services/bridge/registry.ts):
# BRIDGE_RAIL_OUT=cctp_standard
# BRIDGE_RAIL_IN=cctp_fast
