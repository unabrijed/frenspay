# PRODUCTION reference — paste into Railway's Variables tab (production env), never a committed .env.
# Bare names, no prefix. REAL MONEY: walk DEPLOY.md → "Mainnet checklist" before wiring any of this.
# Frontend prod vars (incl. web's ACCESS_KEY gate) live per Vercel project.
NODE_ENV=production

# PORT is injected by Railway — do not set it.

# --- Database (REQUIRED) ---
# Supabase: SESSION pooler only (:5432) — the transaction pooler (:6543) breaks advisory locks.
# DATABASE_URL=postgresql://user:pass@host:5432/postgres

# MUST list EVERY browser origin (web + admin + both landing hosts); a missing one breaks silently.
# CORS_ORIGIN=https://admin.frenspay.xyz,https://frenspay.xyz,https://www.frenspay.xyz,https://<web-domain>

# --- Solana (mainnet) ---
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<KEY>
# HELIUS_API_KEY=
# JSON byte array. FRESH key (never the devnet one), funded with real SOL — monitor its balance.
# FEE_PAYER_SECRET_KEY=
# Circle's mainnet USDC token address — flips isMainnet (gates faucet, /sim, cross-chain on dev tiers).
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Platform cut in bps on top of the LP spread, folded into the quoted rate (default 50).
# PLATFORM_FEE_BPS=50
# ESCROW_PROGRAM_ID=
# PUBLIC ADDRESS ONLY, never the fee-payer. Unset → staking 503s.
# STAKE_TREASURY_ADDRESS=
# HELIUS_WEBHOOK_SECRET=
# PUBLIC_BASE_URL=https://<backend-prod-domain>

# --- Privy ---
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=          # backend-only, never in a web build
# PRIVY_VERIFICATION_KEY=

# --- KYC (both REQUIRED at boot; prod must never run 'sim', and refuses a persona_sandbox_ key) ---
# PERSONA_API_KEY=persona_production_…
# PERSONA_TEMPLATE_ID=itmpl_…
# PERSONA_BASE_URL=https://api.withpersona.com

# --- F list (all four or nothing; unset = safely off) ---
# RESEND_API_KEY=
# EMAIL_FROM=fpay <frens@frenspay.xyz>
# WAITLIST_SECRET=           # write-once: rotating kills outstanding links
# LANDING_URL=https://frenspay.xyz

# --- Admin console: root admins (REQUIRED, comma-separated Privy login addresses) ---
# Always admin regardless of users.role, and the console cannot demote them. This is the lockout
# recovery path: without it, one bad demote leaves psql as the only way back in.
# Prod takes the BARE name — a STAGE_ADMIN_EMAILS here is read by nothing.
# Set this BEFORE the first signup: the console cannot create accounts, so the operator's row is
# made by signing into the web app once, and this list is what turns that row into an admin.
ADMIN_EMAILS=unabrijed@gmail.com

# --- Live FX (defaults are sane; set only to override) ---
# FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
# FX_FALLBACK_RATE=87.55
# FX_FALLBACK_RATE_IDR=16500
# FX_REFRESH_MS=21600000

# --- Xendit payouts (LIVE keys are a licensing/counsel decision, not an env change) ---
# XENDIT_API_URL=https://api.xendit.co
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=

# --- Cross-chain USDC / CCTP (unset = EVM rails off) ---
# ETHEREUM_RPC_URL=
# BASE_RPC_URL=
# ARBITRUM_RPC_URL=
# EVM_MINTER_PRIVATE_KEY=        # fresh for prod, funded with real gas on each chain
# CCTP_FEE_USD_ETHEREUM=2
# CCTP_FEE_USD_BASE=0
# CCTP_FEE_USD_ARBITRUM=0
# CCTP_IN_FEE_USD_ETHEREUM=2
# CCTP_IN_FEE_USD_BASE=0
# CCTP_IN_FEE_USD_ARBITRUM=0
# BRIDGE_RAIL_OUT=cctp_standard
# BRIDGE_RAIL_IN=cctp_fast
