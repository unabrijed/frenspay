# Copy to .env for local dev; on Railway set these in the service Variables tab.
# NODE_ENV picks the prefix (read via src/envConfig.ts): dev/stage → STAGE_*, production → bare.
NODE_ENV=stage

# Locally MUST stay 3001 (web/admin/landing + docs hardcode it). Railway injects its own.
PORT=3001

# --- Database ---
# Supabase: SESSION pooler only (:5432) — the transaction pooler (:6543) breaks advisory locks.
# STAGE_DATABASE_URL=postgresql://user:pass@xxx.pooler.supabase.com:5432/postgres
# STAGE_PGSSL=disable        # only for a local non-SSL Postgres

# Comma-separated BARE origins; empty = allow all (dev). Set LOCAL_ too or localhost inherits stage's.
# LOCAL_CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003
# STAGE_CORS_ORIGIN=https://admin.frenspay.xyz,https://frenspay.xyz,https://www.frenspay.xyz,https://<web-domain>

# --- Solana ---
# Defaults to the public mainnet-beta RPC; a Helius URL is recommended (rate limits + webhooks).
# STAGE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# STAGE_HELIUS_API_KEY=
# JSON byte array (solana-keygen format) ONLY — base58 is rejected.
# STAGE_FEE_PAYER_SECRET_KEY=
# The escrow POOL's key (docs/16): every payer deposit waits in its USDC account until release or
# refund. Same JSON-array shape; needs NO SOL — the fee-payer pays its gas. Never the fee-payer.
# STAGE_ESCROW_SECRET_KEY=
# PUBLIC ADDRESS ONLY — a cold wallet; the platform's cut lands here on release. Payments are ON only
# when the escrow key, the fee-payer and this are all usable (escrowLive); otherwise quote/order 503.
# STAGE_PLATFORM_FEE_DESTINATION=
# Circle's USDC token address ("mint" = Solana's name for a token's identity — nothing gets
# minted). Defaults to the mainnet address (EPjF…) — there is no testnet; set only to override.
# STAGE_USDC_MINT=
# PUBLIC ADDRESS ONLY, never the fee-payer. Unset → staking 503s.
# STAGE_STAKE_TREASURY_ADDRESS=
# STAGE_HELIUS_WEBHOOK_SECRET=
# Host-level (unprefixed). Enables Helius webhook auto-registration; unset = poller only.
# PUBLIC_BASE_URL=https://your-backend.up.railway.app

# --- Privy ---
# STAGE_PRIVY_APP_ID=
# STAGE_PRIVY_APP_SECRET=
# STAGE_PRIVY_VERIFICATION_KEY=

# --- KYC ---
# 'sim' = instant dev promote, 'persona' = real flow (which also needs the API key + template below).
# THIS VARIABLE IS THE ON SWITCH: a deployed tier has no default, so unset = identity checks off, and
# STAGE_KYC_PROVIDER=persona / KYC_PROVIDER=persona must be set explicitly to run them (docs/14).
# Local defaults to sim. `sim` is for a local no-documents run ONLY — stage and prod are both mainnet
# and sim promotes to tier 2 without seeing a document, so the selector refuses it on a deployed tier.
# LOCAL_KYC_PROVIDER=sim
# STAGE_KYC_PROVIDER=persona
# Persona dashboard → API Keys. A persona_sandbox_… key runs the hosted flow with a force-pass toggle
# and no real documents — fine on stage, REFUSED at boot on prod (assertKycConfig). Production keys
# (persona_production_…) arrive only after Persona's compliance review / Startup Program approval.
# STAGE_PERSONA_API_KEY=
# Dashboard → Inquiry Templates (Government ID + Selfie) → itmpl_…
# STAGE_PERSONA_TEMPLATE_ID=
# STAGE_PERSONA_BASE_URL=https://api.withpersona.com

# --- Pay-by-phone OTP ---
# 'console' prints the code to the server log (local default; REFUSED on prod). 'messagecentral'
# (stage/prod default) sends a real SMS via Message Central VerifyNow — console.messagecentral.com,
# 1,000 free OTPs on signup, then ₹0.20/SMS. Unset key = enrollment 502s, everything else runs.
# LOCAL_PHONE_OTP_PROVIDER=console
# Message Central console → customer ID + the base64 key it shows you.
# STAGE_MESSAGECENTRAL_CUSTOMER_ID=
# STAGE_MESSAGECENTRAL_KEY=

# --- LP console + Telegram bot ---
# Where the LP console lives (provider.frenspay.xyz). Alert deep links and the bot's "Open console"
# buttons are built from it — unset, alerts still send but carry NO button, which is the lock race
# the button exists to win. Distinct from WEB_BASE_URL (the payer app).
# STAGE_LP_BASE_URL=https://provider.frenspay.xyz
# One bot PER TIER from @BotFather (docs/13 has the runbook). setWebhook is a property of the
# token, so a shared token means a stage deploy repoints prod's webhook at stage.
# NEVER put the stage token in LOCAL_: the local long-poller would consume stage's updates.
# It refuses to start when LOCAL_ and STAGE_ hold the same token, but don't rely on that.
# LOCAL_TELEGRAM_BOT_TOKEN=
# STAGE_TELEGRAM_BOT_TOKEN=
# Echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token. `openssl rand -hex 32` — base64 is
# REJECTED by Telegram (+ / =). Unset ⇒ /webhooks/telegram refuses every call (fail closed).
# STAGE_TELEGRAM_WEBHOOK_SECRET=

# --- F list: referral loop + confirm email (all four or nothing; unset = safely off) ---
# STAGE_RESEND_API_KEY=
# STAGE_EMAIL_FROM=fpay <frens@frenspay.xyz>
# Write-once: rotating kills outstanding confirm links + re-mints every share code.
# STAGE_WAITLIST_SECRET=
# STAGE_LANDING_URL=https://frenspay.xyz

# --- Admin console: root admins (comma-separated Privy login addresses) ---
# Always admin regardless of users.role, and the console cannot demote them. Everyone else is
# granted/revoked from the UI. This is the lockout recovery path: without it, one bad demote leaves
# psql as the only way back in.
# STAGE_ADMIN_EMAILS=unabrijed@gmail.com

# --- Live FX ---
# STAGE_FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
# STAGE_FX_FALLBACK_RATE=87.55
# STAGE_FX_FALLBACK_RATE_IDR=16500
# STAGE_FX_REFRESH_MS=21600000

# --- Payout providers (TEST keys only; no key = provider row inert) ---
# STAGE_XENDIT_ID_SECRET_KEY=
# STAGE_XENDIT_ID_CALLBACK_TOKEN=
# PUBLIC KEY ONLY — release target for provider-model settlement rows.
# STAGE_PLATFORM_TREASURY_ADDRESS=
