# Local dev: copy to .env. On Railway these are set in the service Variables tab.
#
# Convention: NODE_ENV selects the prefix; every value is read via src/config.ts as
# <PREFIX>_<KEY>. development / stage → STAGE_*, production → unprefixed (no prefix).
# Keep all env reads going through `config` (no direct process.env elsewhere).
NODE_ENV=stage

# Injected unprefixed by the host platform (Railway).
PORT=3000

# --- STAGE config ---
# Postgres. Railway provides this when the DB is attached; for local dev paste the
# PUBLIC connection string (host ends in .proxy.rlwy.net). SSL on by default.
# STAGE_DATABASE_URL=postgresql://user:pass@host:5432/railway
# STAGE_PGSSL=disable        # only for a local non-SSL Postgres
# CORS allowlist (comma-separated origins). Leave empty to allow all (dev). In prod set this to
# your deployed web origin(s), e.g. https://pay.vercel.app
# STAGE_CORS_ORIGIN=

# --- Solana (M1/M2) ---
# Devnet by default; a Helius devnet URL is more reliable + enables webhooks.
# STAGE_SOLANA_RPC_URL=https://api.devnet.solana.com
# STAGE_HELIUS_API_KEY=
# Fee-payer keypair as a JSON byte array (solana-keygen format). `yarn devnet:setup` prints one.
# STAGE_FEE_PAYER_SECRET_KEY=
# On-chain escrow program id (M2). `anchor deploy` prints it; falls back to the IDL address if unset.
# STAGE_ESCROW_PROGRAM_ID=
# SPL mint used as USDC (controlled devnet mint in dev). `yarn devnet:setup` prints one.
# STAGE_USDC_MINT=
# Shared secret for the Helius webhook URL (?secret=...). Open in dev if unset.
# STAGE_HELIUS_WEBHOOK_SECRET=
# Public URL of THIS backend (Railway provides one). Enables Helius webhook auto-registration.
# Read host-level (unprefixed), like PORT. Unset locally → the confirmer poller handles confirmation.
# PUBLIC_BASE_URL=https://your-backend.up.railway.app

# --- Privy (M3) ---
# STAGE_PRIVY_APP_ID=
# STAGE_PRIVY_APP_SECRET=
# Optional: paste the verification key from the Privy dashboard to skip a network fetch per verify.
# STAGE_PRIVY_VERIFICATION_KEY=
