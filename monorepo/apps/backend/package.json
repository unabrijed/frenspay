{
  "name": "@fpay/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --minify --outfile=dist/server.mjs && esbuild src/db/migrate.ts --bundle --platform=node --format=esm --packages=external --minify --outfile=dist/migrate.mjs",
    "start:dist": "node dist/server.mjs",
    "db:deploy:dist": "node dist/migrate.mjs deploy",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:deploy": "tsx src/db/migrate.ts deploy",
    "db:status": "tsx src/db/migrate.ts status",
    "db:new": "tsx src/db/migrate.ts new",
    "db:reset": "tsx src/db/migrate.ts reset",
    "db:init": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "check:admin": "tsx scripts/check-admin.ts",
    "check:straitsx": "tsx scripts/check-straitsx-sandbox.ts && tsx scripts/check-singapore-safety.ts",
    "smoke:straitsx": "tsx scripts/smoke-straitsx-sandbox.ts",
    "check:waitlist": "tsx scripts/check-waitlist.ts",
    "check:invites": "tsx scripts/check-invites.ts",
    "check:flist": "tsx scripts/check-flist-gate.ts",
    "check:fx": "tsx scripts/check-fx.ts",
    "check:routing": "tsx scripts/check-routing-math.ts",
    "check:lock": "tsx scripts/check-lock.ts",
    "check:phone": "tsx scripts/check-phone-otp.ts",
    "check:balance": "tsx scripts/check-balance.ts",
    "check:kyc": "tsx scripts/check-kyc-switch.ts",
    "check:verify": "tsx scripts/check-transfer-verify.ts",
    "check:split": "tsx scripts/check-split.ts",
    "check:bond": "tsx scripts/check-bond.ts",
    "check:escrow": "tsx scripts/check-escrow-switch.ts",
    "check:pool": "tsx scripts/check-escrow-pool.ts",
    "check:gas": "tsx scripts/check-gas-modes.ts",
    "check:prelaunch": "tsx scripts/check-prelaunch.ts",
    "check:flist:access": "tsx scripts/check-flist-access.ts",
    "check:expenses": "tsx scripts/check-expenses.ts",
    "check:expenses:db": "tsx scripts/check-expenses-db.ts",
    "check:expenses:postgres": "EXPENSES_POSTGRES=1 node --import tsx scripts/check-expenses-db.ts",
    "check:payments": "node --import tsx scripts/check-merchant-payments.ts",
    "check:campaign": "node --import tsx scripts/check-campaign.ts",
    "check:campaign:postgres": "CAMPAIGN_POSTGRES=1 node --import tsx scripts/check-campaign.ts",
    "check:dynamic": "node --import tsx scripts/check-dynamic.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@dynamic-labs-wallet/core": "1.1.36",
    "@dynamic-labs-wallet/node-evm": "1.1.36",
    "@fastify/cors": "^10.0.1",
    "@fpay/shared": "*",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@walletconnect/pay": "1.1.0",
    "bignumber.js": "^9.3.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jose": "6.2.0",
    "pg": "^8.13.1",
    "viem": "^2.55.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
