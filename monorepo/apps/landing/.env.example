# Copy to .env.local. Static export — values are inlined at BUILD time; changes need a rebuild.
# Same tier convention as every app: local → NEXT_PUBLIC_LOCAL_* → NEXT_PUBLIC_STAGE_*; prod → bare.

# --- dev / stage ---
# Where the f-list form POSTs. Unset falls back to http://localhost:3001.
NEXT_PUBLIC_STAGE_API_URL=http://localhost:3001
# NEXT_PUBLIC_LOCAL_API_URL=
# Where a valid invite code sends someone. Unset falls back to http://localhost:3000 (web's dev
# port). Until the invite gate, this site linked to the app in neither direction.
NEXT_PUBLIC_STAGE_APP_URL=http://localhost:3000
# NEXT_PUBLIC_LOCAL_APP_URL=

# --- production build (set in Vercel) ---
# NEXT_PUBLIC_API_URL=https://<your-backend-host>
# NEXT_PUBLIC_APP_URL=https://<your-web-host>
