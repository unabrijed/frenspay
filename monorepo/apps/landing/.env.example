# Landing is a static export — these are inlined at build time (Waitlist.tsx, AppLink.tsx).
# Changing either URL requires a rebuild/redeploy. Copy to .env.local for local dev.
NEXT_PUBLIC_API_URL=http://localhost:3001

# The web app. Every "try the demo" link points here, carrying ?ref=@handle when the visitor arrived
# on an invite link — landing and the app are separate origins, so this link is the only way a cached
# referral reaches the signup screen. Unset ⇒ those links fall back to '#' and go nowhere.
NEXT_PUBLIC_APP_URL=http://localhost:3000
