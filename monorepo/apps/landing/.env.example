# Landing is a static export — these are inlined at BUILD time (src/lib/envConfig.ts),
# so changing one requires a rebuild/redeploy, not just a restart.
# Copy this file to .env.local for local dev.
#
# Convention (identical in every app — see apps/web/src/services/envConfig.ts, asserted by
# `yarn check:env`). NEXT_PUBLIC_APP_ENV picks the tier:
#   local (default under `next dev`) → NEXT_PUBLIC_LOCAL_* → NEXT_PUBLIC_STAGE_*
#   stage (a stage deploy sets it)   → NEXT_PUBLIC_STAGE_*
#   production (default in a build)  → NEXT_PUBLIC_* (bare)
# Bare names exist ONLY on the production host, so a stray prod var can never leak into a dev run.

# --- dev / stage ---
# Where the f-list form POSTs (`${API_URL}/waitlist`).
# Unset ⇒ falls back to http://localhost:3001, so local dev works with no .env.local at all.
NEXT_PUBLIC_STAGE_API_URL=http://localhost:3001
# Only if local must differ from stage:
# NEXT_PUBLIC_LOCAL_API_URL=

# --- production build (bare, no tier segment) ---
# Set this in the Vercel project (Production env), pointing at the deployed backend.
# NEXT_PUBLIC_API_URL=https://<your-backend-host>
