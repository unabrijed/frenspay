# Landing is a static export — this is inlined at BUILD time (src/lib/waitlist.ts),
# so changing it requires a rebuild/redeploy, not just a restart.
# Copy this file to .env.local for local dev.

# Where the f-list form POSTs (`${NEXT_PUBLIC_API_URL}/waitlist`).
# Unset ⇒ falls back to http://localhost:3001, so local dev works with no .env.local at all.
# Production: https://<your-backend-host>
NEXT_PUBLIC_API_URL=http://localhost:3001
