{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "git": { "deploymentEnabled": { "stage": false } },
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn workspace @fpay/landing build",
  "ignoreCommand": "node \"$(git rev-parse --show-toplevel)/monorepo/scripts/vercel-ignore.mjs\" landing"
}
