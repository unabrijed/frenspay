{
  "expo": {
    "name": "fpay",
    "slug": "fpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fpay",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bridge.fpay"
    },
    "android": {
      "package": "com.bridge.fpay",
      "adaptiveIcon": {
        "backgroundColor": "#fff8f4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8f4",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "fpay uses the camera to scan a QR code you want to pay."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "fpay shows your contacts only when you pick one to pay."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#b94f2b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
