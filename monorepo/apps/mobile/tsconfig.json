{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@fpay/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@fpay/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@fpay/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@fpay/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@fpay/app": [
        "../../packages/app/src/index.ts"
      ],
      "@fpay/app/*": [
        "../../packages/app/src/*"
      ]
    },
    "moduleSuffixes": [
      ".native",
      ""
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
