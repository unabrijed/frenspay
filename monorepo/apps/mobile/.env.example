# Mobile runtime config (Expo public env — inlined at build time). Copy to .env for local dev.

# Backend base URL the app calls. Leave blank to auto-detect: in Expo Go the app derives
# the dev machine's LAN IP from the Metro host, so physical-device testing works without
# editing this when DHCP changes the IP. Set it only to override — e.g. a cloudflared tunnel
# (cloudflared tunnel --url http://localhost:3000) or a deployed/staging URL.
# EXPO_PUBLIC_API_URL=
# Real backend on (1) or in-memory mock (0). Mock runs with no backend at all.
EXPO_PUBLIC_USE_REAL_API=0
# Solana RPC the client uses to broadcast signed transfers.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Dev signing path (Expo Go, no Privy): identify + sign as a seeded user ---
# From `yarn workspace @pay/backend devnet:setup` output / apps/backend/.devnet/keys.json.
EXPO_PUBLIC_DEV_USER_ID=
EXPO_PUBLIC_DEV_SECRET_KEY=

# --- Privy (dev client only). Setting PRIVY_APP_ID switches auth to email-OTP + embedded wallet. ---
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
