# Mobile runtime config (Expo public env — inlined at build time). Copy to .env for local dev.
# Convention: NODE_ENV picks the var set — dev (`expo start`, NODE_ENV=development) → EXPO_PUBLIC_STAGE_*;
# a production (release) build → EXPO_PUBLIC_* (no STAGE). The app ALWAYS talks to the real backend.

# --- dev / stage (EXPO_PUBLIC_STAGE_*) ---
# Backend base URL. Leave blank to auto-detect the dev machine's LAN IP from Metro (physical-device
# testing without hardcoding a DHCP-churned IP); falls back to http://localhost:3001.
# EXPO_PUBLIC_STAGE_API_URL=
EXPO_PUBLIC_STAGE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Dev signing path (Expo Go, no Privy): a seeded user id + secret key from apps/backend/.devnet/keys.json.
EXPO_PUBLIC_STAGE_DEV_USER_ID=
EXPO_PUBLIC_STAGE_DEV_SECRET_KEY=

# Privy (dev client only). Setting PRIVY_APP_ID switches auth to email-OTP + embedded wallet.
EXPO_PUBLIC_STAGE_PRIVY_APP_ID=
EXPO_PUBLIC_STAGE_PRIVY_CLIENT_ID=

# --- production (release) build (EXPO_PUBLIC_*, no STAGE segment) ---
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_SOLANA_RPC_URL=
# EXPO_PUBLIC_PRIVY_APP_ID=
