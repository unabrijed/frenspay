# Copy to .env. Expo public env, inlined at build: dev → EXPO_PUBLIC_STAGE_*, release build → bare.

# --- dev / stage ---
# Blank = auto-detect the dev machine's LAN IP from Metro; falls back to http://localhost:3001.
# EXPO_PUBLIC_STAGE_API_URL=
EXPO_PUBLIC_STAGE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Dev signing (Expo Go, no Privy) — keys from apps/backend/.devnet/keys.json.
EXPO_PUBLIC_STAGE_DEV_USER_ID=
EXPO_PUBLIC_STAGE_DEV_SECRET_KEY=

# Privy (dev client only); setting the app id switches auth to email-OTP + embedded wallet.
EXPO_PUBLIC_STAGE_PRIVY_APP_ID=
EXPO_PUBLIC_STAGE_PRIVY_CLIENT_ID=

# --- production (release) build ---
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_SOLANA_RPC_URL=
# EXPO_PUBLIC_PRIVY_APP_ID=
