# Copy to .env. Expo public env, inlined at build. Tier = EXPO_PUBLIC_APP_ENV (default: local under
# `expo start`, production in a release build) — same chain as the web's NEXT_PUBLIC_* (check:env):
#   local      → EXPO_PUBLIC_LOCAL_<KEY> → EXPO_PUBLIC_STAGE_<KEY>
#   stage      → EXPO_PUBLIC_STAGE_<KEY>
#   production → EXPO_PUBLIC_<KEY>

# --- every tier ---
# dashboard → App clients) — a different client than the web's, same app.

# --- stage (what a dev build on a phone talks to) ---
EXPO_PUBLIC_STAGE_API_URL=https://stage.api.frenspay.xyz
EXPO_PUBLIC_STAGE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EXPO_PUBLIC_STAGE_LANDING_URL=https://frenspay.xyz

# --- local overrides (win over STAGE_ on the local tier) ---
# Blank API URL = the dev machine's LAN IP that Metro served from, port 3001 (a local backend).
# EXPO_PUBLIC_LOCAL_API_URL=
# EXPO_PUBLIC_LOCAL_DEV_USER_ID=
# EXPO_PUBLIC_LOCAL_DEV_SECRET_KEY=

# --- production (release build) ---
# EXPO_PUBLIC_API_URL=https://api.frenspay.xyz
# EXPO_PUBLIC_SOLANA_RPC_URL=

EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=4fc2a73c-1662-45eb-9257-8baa567066a6
