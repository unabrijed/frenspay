# The LP console reads env through src/services/envConfig.ts and nowhere else (yarn check:env).
# Tier comes from NEXT_PUBLIC_APP_ENV: local (default under `next dev`) → stage → production.

# Local dev: the backend on 3001.
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001

# Backend identity without Privy. Only read on non-production builds, and there is deliberately no
# dev SECRET key here — an LP signs with Privy or not at all.
NEXT_PUBLIC_LOCAL_DEV_USER_ID=

# Privy. The console needs the embedded Solana wallet, not just a bearer token: staking signs a
# real USDC transfer. Same app id as the wallet app — the session is per-origin, the wallet is not.
# Exactly ONE app for every tier, so both names are read BARE on every tier (never
# NEXT_PUBLIC_STAGE_PRIVY_* — nothing reads that).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Cluster. Deployed tiers fail closed to mainnet; only local dev defaults to devnet.
NEXT_PUBLIC_LOCAL_SOLANA_RPC_URL=

# Deploy access gate — server-only (deliberately not NEXT_PUBLIC_), set on the Vercel project. Its OWN
# key, not the wallet app's: a device that passed web's gate still sees this one once, and rotating
# one must not evict the other. Locally: set it to see the key form; leave it unset to run ungated.
# STAGE_ACCESS_KEY=

# Production hosts set the BARE names (NEXT_PUBLIC_API_URL, …, and ACCESS_KEY — a DIFFERENT key than
# stage's) and no NEXT_PUBLIC_APP_ENV.
