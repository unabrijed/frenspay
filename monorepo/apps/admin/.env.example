# Copy to .env.local. The console reads EXACTLY these keys (src/services/envConfig.ts) and ignores
# everything else.
#
# API HOSTS ARE NOT TIERED — this is where admin differs from web/lp/landing. Admin ships as ONE
# deployment that can drive EITHER backend, so both hosts are inlined and the operator picks one in
# the sidebar (src/services/apiMode.ts):
#   NEXT_PUBLIC_LOCAL_API_URL / NEXT_PUBLIC_STAGE_API_URL  → the "stage" target (local wins locally)
#   NEXT_PUBLIC_API_URL                                    → the "prod" target. Unset is a supported
#     state and the current one: the switch hides itself and prod cannot be selected at all.
#
# THE PRIVY APP IS NOT TIERED EITHER, for the opposite reason: there is exactly ONE app and both
# backends verify with it, so tiering the name would mean several names holding one value.
#   NEXT_PUBLIC_PRIVY_APP_ID / NEXT_PUBLIC_PRIVY_CLIENT_ID  → everywhere, every tier.
#
# Everything else (just the dev shim now) still resolves by tier, chosen by NEXT_PUBLIC_APP_ENV:
#   local (default under `next dev`)      → NEXT_PUBLIC_LOCAL_<KEY> → NEXT_PUBLIC_STAGE_<KEY>
#   stage (the deployed console sets it)  → NEXT_PUBLIC_STAGE_<KEY>
#   production (default in a build)       → bare NEXT_PUBLIC_<KEY>

# --- API targets ---
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001
# NEXT_PUBLIC_STAGE_API_URL=https://stage.api.frenspay.xyz
# NEXT_PUBLIC_API_URL=https://api.frenspay.xyz

# --- identity ---

# No-Privy dev: MUST be a user with role='admin' (admin_actions FKs to it). Tiered.
# Only works when the BACKEND has no Privy configured — auth.ts accepts x-dev-user-id solely when
# !privyConfigured(), so with PRIVY_APP_ID/APP_SECRET set in apps/backend/.env (the usual
# state) this line is ignored and every request 401s. Use the Privy block below instead.
NEXT_PUBLIC_LOCAL_DEV_USER_ID=

# The Privy app BOTH backends verify with — one app, one id, every environment. Authorization stays
# server-side (effective role='admin'). Setting the app id is what mounts Privy and renders the Sign
# in button; the client id is optional (Providers.tsx passes `clientId || undefined`).
#
# It used to be one app per target, and the switch swapped it under a reload — the incoming app
# inherited the outgoing app's stored token (Privy's localStorage keys are not app-scoped), its
# refresh threw, and the console hung on "Signing in…". Keep this ONE app: the same id must be set
# as PRIVY_APP_ID on EVERY backend (it is unprefixed on every tier — the trio has no STAGE_ twins),
# or whichever one disagrees refuses every token.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# NEXT_PUBLIC_APP_ENV is deliberately absent here — in .env.local it would point the dev-shim key
# away from LOCAL_.
