# fpay admin console env. Same tier convention as apps/web (services/envConfig.ts):
#   local (next dev)  → NEXT_PUBLIC_LOCAL_<KEY> → falls back to NEXT_PUBLIC_STAGE_<KEY>
#   stage             → NEXT_PUBLIC_STAGE_<KEY>   (deploy sets NEXT_PUBLIC_APP_ENV=stage)
#   production build  → NEXT_PUBLIC_<KEY>
# Copy to .env.local for local dev.

NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001

# No-Privy local dev: a seeded backend user id sent as x-dev-user-id. MUST be a user with
# role='admin' (update users set role='admin' where handle='@you';) — writes FK admin_actions to it.
NEXT_PUBLIC_LOCAL_DEV_USER_ID=

# Privy login (stage/prod). Same app id as the consumer apps; authorization is server-side
# (role='admin' → 403 for everyone else), so sharing the app id is fine.
NEXT_PUBLIC_STAGE_PRIVY_APP_ID=
NEXT_PUBLIC_STAGE_PRIVY_CLIENT_ID=

# Production (set in Vercel): NEXT_PUBLIC_API_URL, NEXT_PUBLIC_PRIVY_APP_ID, NEXT_PUBLIC_PRIVY_CLIENT_ID
