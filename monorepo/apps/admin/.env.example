# Copy to .env.local. Same tier convention as apps/web (services/envConfig.ts):
# local → NEXT_PUBLIC_LOCAL_* → NEXT_PUBLIC_STAGE_*; stage → NEXT_PUBLIC_STAGE_*; prod build → bare.

NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001

# No-Privy dev: MUST be a user with role='admin' (admin_actions FKs to it).
# Only works when the BACKEND has no Privy configured — auth.ts accepts x-dev-user-id solely when
# !privyConfigured(), so with STAGE_PRIVY_APP_ID/APP_SECRET set in apps/backend/.env (the usual
# state) this line is ignored and every request 401s. Use the Privy block below instead.
NEXT_PUBLIC_LOCAL_DEV_USER_ID=

# Same Privy app as the consumer apps — authorization is server-side (role='admin').
NEXT_PUBLIC_STAGE_PRIVY_APP_ID=
NEXT_PUBLIC_STAGE_PRIVY_CLIENT_ID=

# Production (set in Vercel): NEXT_PUBLIC_API_URL, NEXT_PUBLIC_PRIVY_APP_ID, NEXT_PUBLIC_PRIVY_CLIENT_ID
