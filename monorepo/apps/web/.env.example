# Copy to .env.local. NEXT_PUBLIC_APP_ENV picks the tier (src/services/envConfig.ts):
# local → NEXT_PUBLIC_LOCAL_* → NEXT_PUBLIC_STAGE_*; stage → NEXT_PUBLIC_STAGE_*; prod build → bare.
# Always talks to the real backend; no mock mode.

# --- every tier ---
# Privy: exactly ONE app for every tier, so its names are read BARE on every tier — never
# NEXT_PUBLIC_STAGE_PRIVY_* (nothing reads that). Set the app id to mount Privy (email OTP + the
# embedded wallet); unset = the no-Privy dev signing path below.
# NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# --- dev / stage ---
NEXT_PUBLIC_STAGE_API_URL=http://localhost:3001
# Mainnet everywhere, local included: local shares the stage DB, so a devnet cluster here reads
# every mainnet balance as $0. Deployed builds fail CLOSED to mainnet when unset; only the local
# tier defaults to devnet, which is why it has to be set.
# NEXT_PUBLIC_STAGE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_STAGE_LANDING_URL=http://localhost:3003

# No-Privy dev signing (keys from apps/backend/.devnet/keys.json). DEV_SECRET_KEY IS A RAW PRIVATE
# KEY — envConfig reads it only in dev builds, every production bundle strips it (`next dev` only).
# NEXT_PUBLIC_STAGE_DEV_USER_ID=
# NEXT_PUBLIC_STAGE_DEV_SECRET_KEY=

# Customer access uses verified email + invited f-list membership. No shared access key.

# --- production build (bare names, set in the Vercel prod project) ---
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_LANDING_URL=https://frenspay.xyz

# Monad prelaunch web entry. Backend flag + migration must agree; see docs/24.
# Local defaults on; stage/prod default off. No change to native app or legacy balances.

# Monad campaign wallet provider (keep existing NEXT_PUBLIC_PRIVY_* values).
# Local uses NEXT_PUBLIC_LOCAL_; stage uses NEXT_PUBLIC_STAGE_; production uses bare names below.
NEXT_PUBLIC_CAMPAIGN_AUTH_PROVIDER=dynamic
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=4fc2a73c-1662-45eb-9257-8baa567066a6
# NEXT_PUBLIC_CUSTOMER_PAYMENT_MODE=simulation
