# Copy to .env.local. Read via src/services/envConfig.ts — the ONE place this app reads env, with
# the same tier chain as every other app (asserted by `yarn check:env`).
# NEXT_PUBLIC_APP_ENV picks the tier (Next forces NODE_ENV, so it can never carry 'stage'):
#   local (default under `next dev`) → NEXT_PUBLIC_LOCAL_* → NEXT_PUBLIC_STAGE_*
#   stage (a stage deploy sets it)   → NEXT_PUBLIC_STAGE_*
#   production (default in a build)  → NEXT_PUBLIC_* (bare)
# Bare names exist ONLY on the production host, so a stray prod var can never leak into a dev run.
# The app ALWAYS talks to the real backend; there is no mock mode.

# --- dev / stage (NEXT_PUBLIC_STAGE_*) ---
# Backend base URL. Defaults to http://localhost:3001 if unset.
NEXT_PUBLIC_STAGE_API_URL=http://localhost:3001
# NEXT_PUBLIC_STAGE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Privy (web SDK). App Secret stays backend-only, never here.
# NEXT_PUBLIC_STAGE_PRIVY_APP_ID=
# NEXT_PUBLIC_STAGE_PRIVY_CLIENT_ID=
# Marketing site. Where "Share invite" links point (it reads ?ref= and relays the handle back here)
# and where the invite-gate dead end sends people with no code. Defaults to https://frenspay.xyz.
# Locally, point it at whichever port `next dev` picked for landing/ — 3000/3001/3002 are already
# the web app / backend / admin, so it usually lands on 3003.
# NEXT_PUBLIC_STAGE_LANDING_URL=http://localhost:3003

# No-Privy local dev: sign as a seeded devnet wallet from apps/backend/.devnet/keys.json. The user
# id goes out as x-dev-user-id (the backend honours it only when local AND Privy is unconfigured).
#
# NEXT_PUBLIC_STAGE_DEV_SECRET_KEY IS A RAW PRIVATE KEY. Everything NEXT_PUBLIC_* is inlined into
# the browser bundle, so services/envConfig.ts reads these two ONLY inside an `isProduction` branch
# — dead code that any production build strips. Consequences to know:
#   · there is deliberately no bare NEXT_PUBLIC_DEV_SECRET_KEY; setting one on a host does nothing
#   · it is stripped from EVERY build, so the no-Privy wallet demo runs under `next dev` only,
#     not on a deployed stage. Use Privy there.
# `yarn check:env` fails if a new secret-shaped NEXT_PUBLIC_* is added without the same treatment.
# NEXT_PUBLIC_STAGE_DEV_USER_ID=
# NEXT_PUBLIC_STAGE_DEV_SECRET_KEY=

# Deploy access gate (src/middleware.ts). Server-side only — deliberately NOT NEXT_PUBLIC_. Unset =
# gate off (the local default). Generate per environment with `openssl rand -hex 32`; set it on the
# Vercel project, not here. Set locally only to try the gate under `yarn dev:web`.
# STAGE_ACCESS_KEY=

# --- production build (NEXT_PUBLIC_*, no STAGE segment) ---
# Set these in the Vercel project (Production env). NEXT_PUBLIC_API_URL must point at the
# deployed backend, e.g. https://your-backend.up.railway.app
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_PRIVY_CLIENT_ID=
# NEXT_PUBLIC_LANDING_URL=https://frenspay.xyz
