#!/bin/sh
# Build gate. A commit that cannot build does not leave this machine.
#
# Every push builds all four Vercel apps (their vercel.json buildCommand verbatim) +
# `tsc --noEmit` for the backend, which has no build step — it just starts under tsx, so
# a type error there ships and crashes at runtime with nothing red anywhere first. Full
# gate costs a few minutes per push; that is the point — only successful builds get pushed.
#
# It does NOT build the repo-root Dockerfile, so an image-breaking change still leaves the
# machine: that is exactly how packages/ui shipped a broken install (see the Dockerfile's
# manifest rule). The image is built in GitHub Actions on push, where the failure is at
# least loud and nothing deploys — but it is caught after the push, not before it.
#
# Enable (once per clone):  git config core.hooksPath monorepo/.githooks
# Bypass (deliberately):    git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000

# stdin, one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
# Only a push that carries commits gets built — branch deletions have nothing to build.
pushing=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[ -z "$local_sha" ] && continue
	[ "$local_sha" = "$zero" ] && continue
	pushing=1
done
[ -n "$pushing" ] || exit 0

fail() {
	printf '\n\033[31mpre-push refused: %s failed.\033[0m\n' "$1" >&2
	printf 'Fix it, or push anyway with: git push --no-verify\n\n' >&2
	exit 1
}

step() { printf '\n\033[1mpre-push: %s\033[0m\n' "$1"; }

# Vercel and the Docker build both install with --frozen-lockfile; it fails on a lockfile
# that does not cover every declared dep, which a local node_modules happily masks.
# (Railway itself installs nothing now — it pulls a prebuilt image.)
step "yarn install --frozen-lockfile"
(cd monorepo && yarn install --frozen-lockfile) || fail "yarn install --frozen-lockfile"

step "@fpay/landing build"
(cd monorepo && yarn workspace @fpay/landing build) || fail "@fpay/landing build"

step "@fpay/web build"
(cd monorepo && yarn workspace @fpay/web build) || fail "@fpay/web build"

step "@fpay/admin build"
(cd monorepo && yarn workspace @fpay/admin build) || fail "@fpay/admin build"

step "@fpay/lp build"
(cd monorepo && yarn workspace @fpay/lp build) || fail "@fpay/lp build"

step "@fpay/backend typecheck"
(cd monorepo && yarn workspace @fpay/backend tsc --noEmit) || fail "@fpay/backend typecheck"

exit 0
