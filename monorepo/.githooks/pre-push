#!/bin/sh
# Build gate. A commit that cannot build does not leave this machine.
#
# Every push builds all four Vercel apps (their vercel.json buildCommand verbatim) +
# `tsc --noEmit` and the esbuild bundle for the backend. The typecheck catches what tsx
# would otherwise let ship and crash at boot; the bundle catches what only bundling can
# break (a value import of @fpay/shared, which is external in the bundle and would fail to
# resolve inside the image). Full gate costs a few minutes per push; that is the point —
# only successful builds get pushed.
#
# It does NOT build the repo-root Dockerfile (that needs Docker), so an image-breaking change
# can still leave the machine: that is exactly how packages/ui shipped a broken install (see the
# Dockerfile's manifest rule) and how a deleted IDL directory failed the stage image on
# 2026-08-31. The cheap half IS asserted below: every path the Dockerfile copies out of the
# builder must exist in the tree. The image is built in GitHub Actions on push, where the
# failure is at least loud and nothing deploys — but it is caught after the push, not before it.
#
# Enable (once per clone):  git config core.hooksPath monorepo/.githooks
# Bypass (deliberately):    git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000

# stdin, one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
# Only a push that carries commits gets built — branch deletions have nothing to build.
pushing=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[ -z "$local_sha" ] && continue
	[ "$local_sha" = "$zero" ] && continue
	pushing=1
done
[ -n "$pushing" ] || exit 0

fail() {
	printf '\n\033[31mpre-push refused: %s failed.\033[0m\n' "$1" >&2
	printf 'Fix it, or push anyway with: git push --no-verify\n\n' >&2
	exit 1
}

step() { printf '\n\033[1mpre-push: %s\033[0m\n' "$1"; }

# A real key in a TRACKED file. DEPLOY.stage.md carries a "NEVER paste one into this
# tracked file" comment on the very line a real Helius key was once pasted over — a
# warning in prose is not a gate. Runs first because it costs milliseconds and the
# builds below cost minutes. Two shapes only, both seen for real: a live api-key= in a
# URL, and a NAME=<32 hex bytes> secret. Placeholders (<KEY>, <openssl rand -hex 32>),
# Circle's mint and ADMIN_EMAILS do not match. Untracked .env files are never scanned —
# git grep only reads what is tracked, which is exactly the blast radius.
step "secret scan"
if git grep -nIE '(api-key|apikey)=[0-9a-f]{8}-[0-9a-f]{4}-|[A-Z_]+(SECRET|TOKEN|API_KEY)=[0-9a-zA-Z_-]{20,}'; then
	fail "secret scan (a real credential is in a tracked file — move it to apps/backend/.env)"
fi

# The runner stage copies source paths out of the builder. A directory deleted from the tree (the
# shelved escrow program's IDL, 2026-08-31) fails the Railway build after the push, where nothing
# local had looked. This does not build the image; it asserts every `COPY --from=builder /app/<path>`
# names something that exists. Build outputs (node_modules, */dist) exist only inside the builder.
step "Dockerfile copy sources"
for src in $(sed -nE 's#^COPY --from=builder /app/([^ ]+) .*#\1#p' Dockerfile); do
	case "$src" in node_modules|*/dist) continue ;; esac
	[ -e "monorepo/$src" ] || fail "Dockerfile copy source (monorepo/$src does not exist)"
done

# Vercel and the Docker build both install with --frozen-lockfile; it fails on a lockfile
# that does not cover every declared dep, which a local node_modules happily masks.
# (Railway itself installs nothing now — it pulls a prebuilt image.)
step "yarn install --frozen-lockfile"
(cd monorepo && yarn install --frozen-lockfile) || fail "yarn install --frozen-lockfile"

step "@fpay/landing build"
(cd monorepo && yarn workspace @fpay/landing build) || fail "@fpay/landing build"

step "@fpay/web build"
(cd monorepo && yarn workspace @fpay/web build) || fail "@fpay/web build"

step "@fpay/admin build"
(cd monorepo && yarn workspace @fpay/admin build) || fail "@fpay/admin build"

step "@fpay/lp build"
(cd monorepo && yarn workspace @fpay/lp build) || fail "@fpay/lp build"

step "@fpay/backend typecheck"
(cd monorepo && yarn workspace @fpay/backend tsc --noEmit) || fail "@fpay/backend typecheck"

# The image runs these bundles, not src/. If esbuild cannot produce them, the deploy is dead.
step "@fpay/backend bundle"
(cd monorepo && yarn workspace @fpay/backend build) || fail "@fpay/backend bundle"

exit 0
