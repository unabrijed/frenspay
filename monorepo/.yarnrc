# eciesjs and @ecies/ciphers declare engines {bun, deno}. Yarn 1 doesn't know
# those keys and reports them as invalid engines on every install — they reach
# us via @privy-io/react-auth > x402 > wagmi > @metamask/sdk, so we can't fix
# them upstream. No workspace here declares engines of its own, so this masks
# nothing real.
--install.ignore-engines true
